{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "examplegateway": {
      "name": "Example OpenAI-Compatible Gateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://gateway.example.com/v1",
        "apiKey": "{file:~/.config/opencode/litellm-key.txt}"
      },
      "models": {
        "demo-coder": {
          "modelID": "replace-with-actual-model-id",
          "name": "Demo Coder"
        }
      }
    }
  },
  "model": "examplegateway/demo-coder"
}
